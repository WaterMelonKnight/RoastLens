# RoastLens uses an OpenAI-compatible API contract in MVP.
# You can switch providers by changing BASE_URL / API_KEY / MODEL.

# Core
ROASTLENS_LLM_PROVIDER=openai-compatible
ROASTLENS_LLM_BASE_URL=https://api.openai.com
ROASTLENS_LLM_API_KEY=your_api_key_here
ROASTLENS_LLM_MODEL=gpt-4o-mini
ROASTLENS_LLM_TEMPERATURE=0.4
ROASTLENS_LLM_TIMEOUT_SECONDS=45
ROASTLENS_LLM_USE_JSON_RESPONSE_FORMAT=false

# FinStream REST connector (manual, single-event fetch only)
ROASTLENS_FINSTREAM_BASE_URL=http://localhost:8081
ROASTLENS_FINSTREAM_TIMEOUT_SECONDS=5

# -----------------------------
# Provider presets (examples)
# Keep only one active set in your .env
# -----------------------------

# OpenAI (default)
# ROASTLENS_LLM_BASE_URL=https://api.openai.com
# ROASTLENS_LLM_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible)
# ROASTLENS_LLM_BASE_URL=https://api.deepseek.com
# ROASTLENS_LLM_MODEL=deepseek-chat

# Kimi / Moonshot (OpenAI-compatible)
# ROASTLENS_LLM_BASE_URL=https://api.moonshot.cn/v1
# ROASTLENS_LLM_MODEL=moonshot-v1-8k

# OpenRouter (OpenAI-compatible gateway)
# ROASTLENS_LLM_BASE_URL=https://openrouter.ai/api/v1
# ROASTLENS_LLM_MODEL=openai/gpt-4o-mini

# Notes:
# 1) Some providers differ in response-format support; if JSON mode fails, keep:
#    ROASTLENS_LLM_USE_JSON_RESPONSE_FORMAT=false
# 2) Model names change over time. Use the provider's latest official docs.
